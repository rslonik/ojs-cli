{
    "name": "pkp/ojs-cli",
    "description": "Command-line interface for Open Journal Systems",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Public Knowledge Project",
            "email": "pkp-dev@sfu.ca"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.0",
        "symfony/yaml": "^6.0",
        "mustangostang/spyc": "^0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "OJS_CLI\\": "php/OJS_CLI/"
        },
        "files": [
            "php/utils.php",
            "php/class-ojs-cli.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OJS_CLI\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ojs"
    ],
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR2 php/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
